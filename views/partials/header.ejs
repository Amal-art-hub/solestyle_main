<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= typeof title !=='undefined' ? title : 'SoleStyle - Premium Footwear' %>
    </title>

    <!-- External CSS -->
    <link rel="stylesheet" href="/css/user/homestyle.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

    <!-- CRITICAL INLINE CSS: This stops the "writing" flash instantly -->
    <style>
        /* debugging */
        /* 
.container { border: 2px solid blue !important; }        
.header-content { border: 2px solid cyan !important; }   
.header-actions { border: 2px solid yellow !important; } 
.user-menu-container { border: 2px solid red !important; } 
.user-dropdown { border: 2px solid green !important; } */




        #global-page-loader {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: #ffffff;
            z-index: 99999;
            display: flex;
            justify-content: center;
            align-items: center;
            transition: opacity 0.5s ease, visibility 0.5s;
        }

        #global-page-loader.fade-out {
            opacity: 0;
            visibility: hidden;
        }

        /* Essential for the portal dropdown to appear in the right spot */
        /* .user-menu-container {
            position: relative;
        } */
    </style>
</head>

<body>

    <div id="global-page-loader">
        <div id="top-progress-bar"></div>
        <div class="runner-track">
            <div class="shoe-runner">👟</div>
            <div class="track-line"></div>
        </div>
    </div>

    <header class="header">
        <div class="container">
            <div class="header-content">
                <div class="logo">
                    <a href="/">👟 SoleStyle</a>
                </div>

                <nav class="main-nav">
                    <% if(locals.menCategoryId) { %>
                        <a href="/mens-products?category=<%= menCategoryId %>">Men</a>
                        <% } %>
                            <% if(locals.womenCategoryId) { %>
                                <a href="/womens-products?category=<%= womenCategoryId %>">Women</a>
                                <% } %>
                                    <% if(locals.kidsCategoryId) { %>
                                        <a href="/kids-products?category=<%= kidsCategoryId %>">Kids</a>
                                        <% } %>
                </nav>

                <div class="search-bar">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle>
                        <path d="m21 21-4.35-4.35"></path>
                    </svg>
                    <input type="text" placeholder="Search products...">
                </div>

                <div class="header-actions">
                    <% if (typeof user !=='undefined' && user) { %>




                        <!-- </div> -->

                       <a href="/user/wishlist" class="icon-btn" style="text-decoration: none; color: inherit;">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
    </svg>
    <!-- ADD THIS PART BELOW -->
    <% if (locals.wishlistCount > 0) { %>
        <span class="wishlist-badge"><%= wishlistCount %></span>
    <% } %>
</a>

                     <a href="/user/cart" class="icon-btn cart-btn" style="text-decoration: none; color: inherit;">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="9" cy="21" r="1"></circle>
        <circle cx="20" cy="21" r="1"></circle>
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
    </svg>
    <!-- UPDATE THIS PART BELOW -->
    <% if (locals.cartCount > 0) { %>
        <span class="cart-badge"><%= cartCount %></span>
    <% } %>
</a>

                        <!-- WRAP THE BUTTON AND DROPDOWN IN THIS CONTAINER -->
                        <div class="user-menu-container">
                            <button class="icon-btn user-menu-trigger" onclick="toggleUserMenu()">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="12" cy="7" r="4"></circle>
                                </svg>
                            </button>


                            <div class="user-dropdown" id="userDropdown">
                                <div class="user-info">
                                    <strong>
                                        <%= user.name %>
                                    </strong>
                                    <span>
                                        <%= user.email %>
                                    </span>
                                </div>
                                <hr>
                                <a href="/user/profile">My Profile</a>
                                <a href="/user/orders">My Orders</a>
                               
                                <a href="/user/settings">payment method</a>
                                <a href="/user/addresses">address book</a>
                                <a href="/user/wallet">wallet</a>
                           
                                <a href="javascript:void(0)" onclick="openModal('couponModal')">Coupons / Rewards</a>

                
                                <hr>
                                <a href="/logout" class="logout-link">Logout</a>
                            </div>
                        </div>

                        <% } else { %>
                            <a href="/Login" class="btn-text">Login</a>
                            <a href="/signup" class="btn-primary-small">Sign Up</a>
                            <% } %>
                </div>
            </div>
        </div>
    </header>

    <script>
        // NEW CODE (Much faster)
        document.addEventListener('DOMContentLoaded', function () {
            const loader = document.getElementById('global-page-loader');
            if (loader) {
                // We add a tiny 300ms delay just so the user sees the animation briefly
                setTimeout(() => {
                    loader.classList.add('fade-out');
                }, 50);
            }
        });

        function toggleUserMenu() {
            const dropdown = document.getElementById('userDropdown');
            if (dropdown) {
                dropdown.classList.toggle('show');
            }
        }

        window.addEventListener('click', function (e) {
            if (!e.target.closest('.user-menu-container')) {
                const dropdown = document.getElementById('userDropdown');
                if (dropdown) dropdown.classList.remove('show');
            }
        });
           
        /* --- Replace your existing openModal function with this --- */
function openModal(id) {
    const modal = document.getElementById(id); // Look for the "Box"
    
    if (modal) {
        // We found it! (You are on the Profile page)
        modal.style.display = 'flex';
    } else {
        // Not found! (You are on Home/Cart/Products)
        // Take the user to the Profile page where the box exists
        window.location.href = '/user/profile'; 
    }
}

/* Add this too, to close the modal */
function closeModal(id) {
    const modal = document.getElementById(id);
    if (modal) modal.style.display = 'none';
}

    

    </script>