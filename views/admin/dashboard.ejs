<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Admin Dashboard - SoleStyle</title>
    <link rel="stylesheet" href="/css/admin/dashboard-side.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body>
    <div class="container">

        <%- include('../partials/adminSideBar', { activePage: 'dashboard' }) %>
            <link rel="stylesheet" href="/css/admin/modern-dashboard.css">
            <div class="main-content dashboard-container">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="fw-bold">Business Overview</h2>
                </div>
                <!-- 1. Stats Cards -->
                <div class="stats-grid">
                    <div class="stat-card">
                        <h3>Total Revenue</h3>
                        <div class="value">₹<%= stats.totalRevenue.toLocaleString() %>
                        </div>
                    </div>
                    <div class="stat-card">
                        <h3>Total Orders</h3>
                        <div class="value">
                            <%= stats.totalOrders %>
                        </div>
                    </div>
                    <div class="stat-card">
                        <h3>Active Customers</h3>
                        <div class="value">
                            <%= stats.totalUsers %>
                        </div>
                    </div>
                    <div class="stat-card">
                        <h3>Product Catalog</h3>
                        <div class="value">
                            <%= stats.totalProducts %>
                        </div>
                    </div>
                </div>
                <!-- 2. Interactive Chart Section -->
                <div class="chart-container">
                    <div class="chart-header">
                        <h4 class="m-0 fw-bold">Sales Statistics</h4>
                        <div class="filter-group">
                            <button class="filter-btn" data-filter="daily">Daily</button>
                            <button class="filter-btn" data-filter="weekly">Weekly</button>
                            <button class="filter-btn active" data-filter="monthly">Monthly</button>
                            <button class="filter-btn" data-filter="yearly">Yearly</button>
                        </div>
                    </div>
                    <div id="salesChart"></div>
                </div>

    <!-- 3. Top Performers Rankings -->
    <div class="rankings-grid">
        <!-- Top Products -->
        <div class="ranking-card">
            <div class="ranking-header">
                <i class="fas fa-box-open text-primary"></i>
                <h4 class="m-0">Top Products</h4>
            </div>
            <div class="ranking-list">
                <% topProducts.forEach((item, index) => { %>
                    <div class="ranking-item">
                        <span class="rank-number"><%= index + 1 %></span>
                        <div class="rank-info">
                            <p class="rank-name"><%= item.name %></p>
                            <small class="rank-qty"><%= item.totalQty %> units sold</small>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>

        <!-- Top Categories -->
        <div class="ranking-card">
            <div class="ranking-header">
                <i class="fas fa-layer-group text-success"></i>
                <h4 class="m-0">Top Categories</h4>
            </div>
            <div class="ranking-list">
                <% topCategories.forEach((item, index) => { %>
                    <div class="ranking-item">
                        <span class="rank-number"><%= index + 1 %></span>
                        <div class="rank-info">
                            <p class="rank-name"><%= item.name %></p>
                            <small class="rank-qty"><%= item.totalQty %> units sold</small>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>

        <!-- Top Brands -->
        <div class="ranking-card">
            <div class="ranking-header">
                <i class="fas fa-tag text-warning"></i>
                <h4 class="m-0">Top Brands</h4>
            </div>
            <div class="ranking-list">
                <% topBrands.forEach((item, index) => { %>
                    <div class="ranking-item">
                        <span class="rank-number"><%= index + 1 %></span>
                        <div class="rank-info">
                            <p class="rank-name"><%= item.name %></p>
                            <small class="rank-qty"><%= item.totalQty %> units sold</small>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>




            </div>
            <!-- SCRIPTS -->
            <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
            <script>
                // Passing initial data from EJS to external JS file
                const initialChartData = <%- JSON.stringify(chartData) %>;
            </script>
            <script src="/js/admin/dashboard.js"></script>
    </div>
</body>

</html>