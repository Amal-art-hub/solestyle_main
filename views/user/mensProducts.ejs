<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>
        <%= (products && products.length> 0) ? products[0].categoryId.name + "'s Collection" : "Collection" %> |
            SoleStyle
    </title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <link rel="stylesheet" href="/css/user/homestyle.css">
    <link rel="stylesheet" href="/css/user/mensProducts.css">
    <style>
        .search-container {
            position: relative;
            flex-grow: 1;
            max-width: 400px;
        }

        .search-suggestions-dropdown {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background: white;
            border: 1px solid #ddd;
            border-top: none;
            border-radius: 0 0 8px 8px;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
            z-index: 1000;
            max-height: 400px;
            overflow-y: auto;
            display: none;
        }

        .suggestion-item {
            display: flex;
            align-items: center;
            padding: 10px 15px;
            cursor: pointer;
            transition: background 0.2s;
            border-bottom: 1px solid #f5f5f5;
        }

        .suggestion-item:last-child {
            border-bottom: none;
        }

        .suggestion-item:hover {
            background-color: #f9f9f9;
        }

        .suggestion-image {
            width: 40px;
            height: 40px;
            object-fit: cover;
            border-radius: 4px;
            margin-right: 12px;
            border: 1px solid #eee;
        }

        .suggestion-info {
            display: flex;
            flex-direction: column;
        }

        .suggestion-name {
            font-size: 0.9rem;
            font-weight: 600;
            color: #333;
        }

        .suggestion-price {
            font-size: 0.8rem;
            color: #27ae60;
            font-weight: bold;
        }

        .no-suggestions {
            padding: 15px;
            color: #999;
            text-align: center;
            font-size: 0.9rem;
        }
    </style>
</head>

<body>
    <%- include('../partials/header') %>
        <div class="product-page-container">

            <!-- Sidebar Filters -->
            <aside class="filters-sidebar">
                <form action="/shop" method="GET">
                    <input type="hidden" name="category" value="<%= categoryId %>">
                    <input type="hidden" name="search" value="<%= search %>">
                    <input type="hidden" name="sort" value="<%= sort %>">
                    <h3>Filters</h3>

                    <!-- Price Filter -->
                    <div class="filter-group">
                        <h4>Price Range</h4>
                        <input type="number" name="minPrice" placeholder="Min" value="<%= filters.minPrice %>">
                        <input type="number" name="maxPrice" placeholder="Max" value="<%= filters.maxPrice %>">
                    </div>
                    <!-- Brand Filter -->
                    <div class="filter-group">
                        <h4>Brands</h4>
                        <% filterOptions.brands.forEach(brand=> { %>
                            <label>
                                <input type="checkbox" name="brand" value="<%= brand._id %>"
                                    <%=filters.brand===brand._id.toString() ? 'checked' : '' %>>
                                <%= brand.name %>
                            </label>
                            <% }) %>
                    </div>
                    <div class="filter-actions">
                        <button type="submit">Apply</button>
                        <a href="/shop?category=<%= categoryId %>">Clear</a>
                    </div>
                </form>
            </aside>
            <!-- Main Content -->
            <main class="product-grid-section">

                <!-- Top Bar: Search & Sort -->
                <div class="top-bar">
                    <form action="/shop" method="GET" class="search-form">
                        <input type="hidden" name="category" value="<%= categoryId %>">
                        <div class="search-container">
                            <input type="text" name="search" id="productSearchInput" placeholder="Search..."
                                value="<%= search %>" autocomplete="off">
                            <div id="searchSuggestions" class="search-suggestions-dropdown"></div>
                        </div>
                        <button type="submit">🔍</button>
                    </form>
                    <div class="sort-box">
                        <label>Sort By:</label>
                        <select onchange="location = this.value;">
                            <!-- Helper to build URL with current params + new sort -->

                            <% const buildUrl=(s)=> {
                                let url = `?category=${categoryId}&search=${search}&sort=${s}`;
                                if(filters.minPrice) url += `&minPrice=${filters.minPrice}`;
                                if(filters.maxPrice) url += `&maxPrice=${filters.maxPrice}`;
                                if(filters.brand) url += `&brand=${filters.brand}`;
                                return url;
                                } %>

                                <option value="<%= buildUrl('newest') %>" <%=sort==='newest' ? 'selected' : '' %>>Newest
                                </option>
                                <option value="<%= buildUrl('price-low') %>" <%=sort==='price-low' ? 'selected' : '' %>
                                    >Price: Low to High</option>
                                <option value="<%= buildUrl('price-high') %>" <%=sort==='price-high' ? 'selected' : ''
                                    %>>Price: High to Low</option>
                                <option value="<%= buildUrl('a-z') %>" <%=sort==='a-z' ? 'selected' : '' %>>Name: A-Z
                                </option>
                                <option value="<%= buildUrl('z-a') %>" <%=sort==='z-a' ? 'selected' : '' %>>Name: Z-A
                                </option>
                        </select>
                    </div>
                </div>
                <!-- Products Grid -->
                <div class="products-grid">
                    <% products.forEach(p=> { %>
                        <!-- <div class="product-card">
                            <a href="/product/<%= p._id %>">
                                <img src="/uploads/variant-images/<%= p.image %>" alt="<%= p.name %>">
                                <div class="info">
                                    <h3>
                                        <%= p.name %>
                                    </h3>
                                    <p class="brand">
                                        <%= p.brandId.name %>
                                    </p>
                                    <p class="price">₹<%= p.price.toLocaleString() %>
                                    </p>
                                </div>
                            </a>
                                <button class="wishlist-btn" onclick="addToWishlist('<%= p._id %>', '<%= p.variantId %>')">
        <i class="fas fa-heart"></i>
    </button>
                            
                        </div> -->

                        <div class="product-card">
                            <a href="/product/<%= p._id %>">

                                <!-- NEW: Image Badge -->
                                <div class="image-wrapper" style="position: relative;">
                                    <img src="<%= p.image.startsWith('http') ? p.image : '/uploads/variant-images/' + p.image %>"
                                        alt="<%= p.name %>" loading="lazy" class="product-image">
                                    <% if (p.discount> 0) { %>
                                        <span style="
                    position: absolute;
                    top: 10px;
                    left: 10px;
                    background: #27ae60;
                    color: white;
                    padding: 4px 8px;
                    border-radius: 4px;
                    font-size: 0.8rem;
                    font-weight: bold;
                ">
                                            <%= p.discount %>% OFF
                                        </span>
                                        <% } %>


                                            <% if (p.isExpiringSoon) { %>
                                                <span
                                                    style="position: absolute; top: 40px; left: 10px; background: #d9534f; color: white; padding: 4px 8px; border-radius: 4px; font-size: 0.7rem; font-weight: bold;">
                                                    🔥 OFFER ENDS SOON!
                                                </span>
                                                <% } %>
                                </div>
                                <div class="info">
                                    <h3>
                                        <%= p.name %>
                                    </h3>
                                    <p class="brand">
                                        <%= p.brandId.name %>
                                    </p>

                                    <!-- NEW: Price Logic -->
                                    <div class="price-container">
                                        <% if (p.discount> 0) { %>
                                            <!-- Discounted State -->
                                            <span class="price" style="color: #d9534f; font-weight: bold;">
                                                ₹<%= p.price.toLocaleString() %>
                                            </span>
                                            <span class="original-price"
                                                style="text-decoration: line-through; color: #888; font-size: 0.9em; margin-left: 5px;">
                                                ₹<%= p.originalPrice.toLocaleString() %>
                                            </span>
                                            <% } else { %>
                                                <!-- Normal State -->
                                                <span class="price">₹<%= p.price.toLocaleString() %></span>
                                                <% } %>
                                    </div>
                                </div>
                            </a>
                            <!-- ... Wishlist Button ... -->
                        </div>

                        <% }) %>
                </div>
                <!-- Pagination -->


                <%- include('../partials/pagination') %>
                    <!-- <div class="pagination">
                    <% for(let i=1; i<=totalPages; i++) { %>
                  
                        <a href="?category=<%= categoryId %>&page=<%= i %>&search=<%= search %>&sort=<%= sort %>&minPrice=<%= filters.minPrice %>&maxPrice=<%= filters.maxPrice %>&brand=<%= filters.brand %>"
   class="<%= currentPage == i ? 'active' : '' %>">
    <%= i %>
</a>
                        <% } %>
                </div> -->
            </main>
        </div>
        <%- include('../partials/footer') %>
            <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
            <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
            <script>
                // Search Autocomplete Logic
                (function () {
                    const searchInput = document.getElementById('productSearchInput');
                    const suggestionsDropdown = document.getElementById('searchSuggestions');
                    let debounceTimer;

                    if (!searchInput || !suggestionsDropdown) return;

                    searchInput.addEventListener('input', function () {
                        const query = this.value.trim();
                        clearTimeout(debounceTimer);

                        if (query.length < 1) {
                            suggestionsDropdown.style.display = 'none';
                            return;
                        }

                        debounceTimer = setTimeout(() => {
                            fetchSuggestions(query);
                        }, 300); // 300ms debounce
                    });

                    async function fetchSuggestions(query) {
                        try {
                            const response = await axios.get(`/search-suggestions?q=${encodeURIComponent(query)}`);
                            if (response.data.success) {
                                renderSuggestions(response.data.suggestions);
                            }
                        } catch (error) {
                            console.error('Error fetching suggestions:', error);
                        }
                    }

                    function renderSuggestions(suggestions) {
                        if (suggestions.length === 0) {
                            suggestionsDropdown.innerHTML = '<div class="no-suggestions">No products found</div>';
                            suggestionsDropdown.style.display = 'block';
                            return;
                        }

                        suggestionsDropdown.innerHTML = suggestions.map(item => `
                            <div class="suggestion-item" onclick="window.location.href='/product/${item._id}'">
                                <img src="${item.image.startsWith('http') ? item.image : '/uploads/variant-images/' + item.image}" 
                                     class="suggestion-image" alt="${item.name}">
                                <div class="suggestion-info">
                                    <span class="suggestion-name">${item.name}</span>
                                </div>
                            </div>
                        `).join('');

                        suggestionsDropdown.style.display = 'block';
                    }

                    // Close dropdown when clicking outside
                    document.addEventListener('click', function (e) {
                        if (!e.target.closest('.search-container')) {
                            suggestionsDropdown.style.display = 'none';
                        }
                    });

                    // Show dropdown again if user clicks back into input (if it has value)
                    searchInput.addEventListener('focus', function () {
                        if (this.value.trim().length > 0 && suggestionsDropdown.children.length > 0) {
                            suggestionsDropdown.style.display = 'block';
                        }
                    });
                })();

                async function addToWishlist(productId, variantId) {
                    try {
                        if (!productId || !variantId) {
                            return Swal.fire('Error', 'Product info missing', 'error');
                        }
                        const response = await axios.post('/user/wishlist/add', {
                            productId, variantId
                        });

                        if (response.data.success) {
                            Swal.fire({
                                toast: true,
                                position: 'top-end',
                                icon: 'success',
                                title: 'Added to Wishlist',
                                showConfirmButton: false,
                                timer: 3000
                            });
                        } else {
                            Swal.fire({
                                toast: true,
                                position: 'top-end',
                                icon: 'info',
                                title: response.data.message, // e.g., "Already in wishlist"
                                showConfirmButton: false,
                                timer: 3000
                            });
                        }
                    } catch (error) {
                        if (error.response && error.response.status === 401) {
                            window.location.href = '/login'; // Redirect if not logged in
                        } else {
                            console.error(error);
                            Swal.fire('Error', 'Something went wrong', 'error');
                        }
                    }
                }
            </script>
</body>

</html>